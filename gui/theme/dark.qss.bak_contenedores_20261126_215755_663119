QWidget { color: #D7E6F5; font-family: "Segoe UI"; font-size: 10pt; }

QMainWindow, QDialog {
    background-color: #0B1320;
}

QLabel[panelHeading="true"] {
    color: #D6F7FF;
    font-weight: 700;
}

QFrame#measurementCard,
QFrame#summaryCard {
    background-color: #142033;
    border: 1px solid #2E4A67;
    border-radius: 8px;
}
QFrame#measurementCard QLabel,
QFrame#summaryCard QLabel {
    background: transparent;
}
QFrame#measurementCard QPushButton {
    background: transparent;
    color: #A7BED6;
    border: none;
}
QFrame#measurementCard QPushButton:hover {
    color: #EAF5FF;
    background-color: #1A2A41;
}

QPushButton, QToolButton {
    background-color: #1A2A41;
    color: #EAF5FF;
    border: 1px solid #2E4A67;
    border-radius: 7px;
    padding: 7px 12px;
    min-height: 24px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #223754;
    border-color: #21D4F5;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: #17283D;
}
QPushButton:disabled, QToolButton:disabled {
    color: #7088A2;
    background-color: #101A29;
    border-color: #24374F;
}

QPushButton#navButton {
    background-color: #162539;
    color: #DCEEFF;
    border: 1px solid #315270;
    border-radius: 5px;
    padding: 3px 4px;
    font-size: 9pt;
    font-weight: 600;
}
QPushButton#navButton:hover { background-color: #1D324B; border-color: #3BE4FF; }
QPushButton#navButton:checked {
    background-color: #143B57;
    border-color: #3BE4FF;
    color: #FFFFFF;
}

QPushButton[role="success"] {
    background-color: #1C5B52;
    border-color: #33DDB7;
    color: #EFFFF9;
}
QPushButton[role="success"]:hover { background-color: #237365; }
QPushButton[role="danger"] {
    background-color: #5A2E3D;
    border-color: #A44B57;
    color: #FFEFF2;
}
QPushButton[role="danger"]:hover { background-color: #744154; }
QPushButton[role="warning"] {
    background-color: #6E4B1E;
    border-color: #C08A3A;
    color: #FFF6E9;
}
QPushButton[role="warning"]:hover { background-color: #8C6024; }
QPushButton[role="accent"] {
    background-color: #123A55;
    border-color: #21D4F5;
    color: #EAFBFF;
}
QPushButton[role="accent"]:hover { background-color: #174C6E; }
QPushButton[role="violet"] {
    background-color: #433075;
    border-color: #8D63F8;
    color: #F4EEFF;
}
QPushButton[role="violet"]:hover { background-color: #563E91; }
QPushButton[role="toggle"]:checked {
    background-color: #1C5B52;
    border-color: #33DDB7;
    color: #EFFFF9;
}

QToolButton#waveButton {
    background-color: #1A2A41;
    color: #DCEEFF;
    border: 1px solid #335675;
    border-radius: 6px;
    padding: 4px;
}
QToolButton#waveButton:checked {
    background-color: #163D44;
    border: 2px solid #33DDB7;
    color: #F2FFFC;
    padding: 3px;
}
QToolButton#waveButton:disabled {
    background-color: #142033;
    color: #839AB1;
}

QToolButton#exportButton {
    background-color: #162539;
    color: #EAF5FF;
    border: 1px solid #315270;
    border-radius: 4px;
    padding: 2px 16px;
    font-weight: 600;
}
QToolButton#exportButton:hover { background-color: #1D324B; }
QToolButton#exportButton::menu-indicator { subcontrol-position: right center; right: 6px; }

QToolButton#sectionResetButton {
    color: #AFC5DA;
    background: rgba(33, 212, 245, 0.08);
    border: 1px solid rgba(33, 212, 245, 0.28);
    border-radius: 5px;
    padding: 0;
    font-size: 18px;
}
QToolButton#sectionResetButton:hover {
    background: rgba(33, 212, 245, 0.18);
    color: #EAFBFF;
}
QToolButton#sectionResetButton:pressed {
    background: rgba(33, 212, 245, 0.28);
}

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #142033;
    color: #EAF5FF;
    border: 1px solid #2E4A67;
    border-radius: 6px;
    padding: 5px;
    min-height: 24px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: #21D4F5;
}

QMenuBar {
    background-color: #142033;
    color: #EAF5FF;
}
QMenuBar::item { padding: 7px 12px; }
QMenuBar::item:selected, QMenu::item:selected { background-color: #1D324B; }
QMenu {
    background-color: #142033;
    color: #EAF5FF;
    border: 1px solid #2E4A67;
}
QMenu::item { padding: 6px 24px; }

QStatusBar {
    background-color: #142033;
    color: #A7BED6;
}

QGroupBox {
    border: 1px solid #2E4A67;
    border-radius: 8px;
    margin-top: 12px;
    padding: 10px 6px 6px 6px;
    font-weight: 600;
    background-color: #101C2D;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #D6F7FF;
}
QGroupBox[compactResetHeader="true"] { margin-top: 0px; padding-top: 4px; }

QScrollArea { border: none; }
QScrollBar:vertical { background: #142033; width: 9px; }
QScrollBar::handle:vertical {
    background: #315270;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QTabWidget::pane {
    background-color: #101C2D;
    border: 1px solid #355675;
    border-radius: 7px;
    top: -1px;
}
QTabBar::tab {
    background-color: #162539;
    color: #DCEEFF;
    border: 1px solid #355675;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 17px;
    margin-right: 3px;
    min-width: 44px;
}
QTabBar::tab:selected {
    background-color: #143B57;
    color: #FFFFFF;
    border-color: #3BE4FF;
    font-weight: bold;
}
QTabBar::tab:!selected:hover {
    background-color: #1D324B;
    color: #FFFFFF;
    border-color: #3BA0C0;
}
QTabBar::tab:disabled {
    background-color: #132032;
    color: #8197AE;
    border-color: #284158;
}

/* OSC_SCOPE_CONTRAST_V3 */

QMainWindow, QDialog, QStackedWidget, QScrollArea { background-color: #0B1523; }
QGroupBox { background-color: #142336; border-color: #344B62; }
QGroupBox::title { color: #F2F8FF; background: transparent; }
QLabel, QCheckBox, QRadioButton { background: transparent; color: #D7E6F5; }
QLabel[panelHeading="true"], QLabel[scopeRole="heading"] { color: #F2F8FF; font-weight: 600; }
QLabel#featureStatusLabel, QLabel[scopeRole="muted"] { color: #A0B5CB; background: transparent; }
QLabel#featureStatusLabel { font-size: 9px; padding: 0px 2px; }
QLabel[scopeRole="math"] { color: #61DBBB; font-size: 21px; font-weight: 600; background: transparent; }
QFrame#measurementCard, QFrame#mathSummary { background-color: #192B40; border: 1px solid #344B62; border-radius: 7px; }
QFrame#measurementCard QWidget { background: transparent; }
QFrame#measurementCard QLabel[scopeRole="ch1"] { color: #FFE45C; }
QFrame#measurementCard QLabel[scopeRole="ch2"] { color: #63C7EF; }
QFrame#measurementCard QLabel[scopeRole="pair"] { color: #D7E6F5; }
QFrame#measurementCard QLabel[scopeRole="muted"] { color: #A0B5CB; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { background-color: #1D3047; color: #D7E6F5; border-color: #344B62; }
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover { border-color: #32D3E8; }
QComboBox QAbstractItemView, QListWidget, QTableWidget { background-color: #192B40; alternate-background-color: #142336; color: #D7E6F5; selection-background-color: #173D50; selection-color: #F2F8FF; }
QHeaderView::section { background-color: #1D3047; color: #F2F8FF; border: 1px solid #344B62; }
QPushButton#navButton { background-color: #142336; border: 1px solid #344B62; color: #D7E6F5; padding: 2px 1px; font-size: 9px; min-width: 0; min-height: 22px; }
QPushButton#navButton:hover { background-color: #243C54; border-color: #32D3E8; }
QPushButton#navButton:checked { background-color: #173D50; color: #F2F8FF; border-color: #32D3E8; }
QPushButton[role="success"], QPushButton[role="danger"], QPushButton[role="warning"], QPushButton[role="accent"], QPushButton[role="violet"], QPushButton[role="toggle"] { padding: 3px 6px; font-weight: 600; min-height: 23px; }
QPushButton[role]:disabled { background-color: #142336; color: #8297AC; border-color: #344B62; }
QPushButton[role="accent"] { background-color: #1D3047; color: #D7E6F5; border-color: #344B62; }
QPushButton[role="accent"]:hover:enabled { background-color: #243C54; border-color: #32D3E8; }
QPushButton[role="accent"]:disabled { background-color: #142336; color: #8297AC; border-color: #344B62; }
QToolButton#exportButton { padding: 2px 8px; font-size: 10px; min-height: 22px; }
QToolButton#sectionResetButton { min-height: 0; padding: 0; }
QToolButton#waveButton { background-color: #1D3047; border-color: #344B62; color: #D7E6F5; }
QToolButton#waveButton:checked { background-color: #173D50; border-color: #61DBBB; color: #F2F8FF; }
QToolButton#waveButton:disabled { color: #8297AC; background-color: #142336; }
QMenuBar, QMenu, QStatusBar { background-color: #142336; color: #D7E6F5; }
QTabWidget::pane { background-color: #142336; border-color: #344B62; }
QTabBar::tab { background-color: #1D3047; color: #D7E6F5; border-color: #344B62; }
QTabBar::tab:selected { background-color: #173D50; border-color: #32D3E8; color: #F2F8FF; }
